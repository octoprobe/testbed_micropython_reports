{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "DIRECTORY_REPORTS": "${workspaceFolder:testbed_micropython_reports}/reports",
                "WEBHOOK_SECRET": "1243",
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "jinja": true
        },
        {
            "name": "parse_logfile.py",
            "type": "debugpy",
            "request": "launch",
            "module": "app.parse_logfile",
            "args": [],
            "cwd": "${workspaceFolder}",
            "jinja": true
        },
        {
            "name": "purge_reports.py",
            "type": "debugpy",
            "request": "launch",
            "module": "app.util_github2",
            "env": {
                "DIRECTORY_REPORTS": "${workspaceFolder:testbed_micropython_reports}/reports",
                "WEBHOOK_SECRET": "1243",
            },
            "cwd": "${workspaceFolder}",
            "jinja": true
        },
        {
            "name": "recurring_job.py",
            "type": "debugpy",
            "request": "launch",
            "module": "app.util_celery_tasks",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "DIRECTORY_REPORTS": "${workspaceFolder:testbed_micropython_reports}/reports/"
            },
            "jinja": true
        },
        {
            "name": "pytest",
            "type": "debugpy",
            "request": "launch",
            "purpose": [
                "debug-test"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "subProcess": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder:testbed_micropython_reports}"
            }
        },
        {
            "name": "mptest reports",
            "type": "debugpy",
            "request": "launch",
            "module": "testbed_micropython.mptest.cli",
            "cwd": "${workspaceFolder:testbed_micropython_reports}",
            "args": [
                "reports",
                "--reports=${workspaceFolder:testbed_micropython_reports}/reports",
                "--url-reports=http://localhost:8000",
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
        },
        {
            "name": "mptest reports http-server",
            "type": "debugpy",
            "request": "launch",
            "module": "http.server",
            "cwd": "${workspaceFolder:testbed_micropython_reports}/reports",
            "args": [],
            "console": "integratedTerminal",
            "justMyCode": false,
        },
    ]
}